    {
      "id": "text-84",
      "type": "text",
      "x": 1812,
      "y": 120.25,
      "width": 1082.4,
      "height": 30,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "frame-70",
      "roundness": null,
      "seed": 665196,
      "version": 1,
      "versionNonce": 8797236,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "One session holds a server at a time, so the pool is the session cap: as many sessions may be open at once as there are entries in it. The session's project decides\nwhich database name is used on it (created if missing); its setup commands are where migrations and seeding happen, on every session.",
      "originalText": "One session holds a server at a time, so the pool is the session cap: as many sessions may be open at once as there are entries in it. The session's project decides\nwhich database name is used on it (created if missing); its setup commands are where migrations and seeding happen, on every session.",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "text-85",
      "type": "text",
      "x": 1812,
      "y": 158.25,
      "width": 836.5500000000001,
      "height": 16.25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "frame-70",
      "roundness": null,
      "seed": 673115,
      "version": 1,
      "versionNonce": 8901965,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "2 servers in the pool, so 2 sessions with a database may be open at once. 1 more is listed but taken out of the pool.",
      "originalText": "2 servers in the pool, so 2 sessions with a database may be open at once. 1 more is listed but taken out of the pool.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
