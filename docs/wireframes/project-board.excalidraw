    {
      "id": "text-84",
      "type": "text",
      "x": 0,
      "y": 980,
      "width": 1771.0000000000002,
      "height": 140,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 665196,
      "version": 1,
      "versionNonce": 8797236,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Reference: briareus-windows. Other clients match this structure, differing only as noted here.\nColumns are 300 to 380px with 12px gaps and share the width when they fit; otherwise the board scrolls sideways with a bar along the bottom. Each column scrolls on its own down to the window's bottom.\nYou can drag a card to another column (needs a Manage token and Projects: write). A card from another repository opens on GitHub; a card from this one opens its issue or PR in the side panel, which really overlays the board rather\nthan taking the 272px right column.\nWith an assignee picked, a 'Showing 5 of 14' line with an accent 'Clear filter' link shows above the columns. A board over 2,000 items warns 'Only the board's first 2,000 items are shown.'\nErrors and empty state: 'Reading a board needs Projects: read on the server's GitHub token (read:project on a classic token)…' / 'Nothing on the board — No item on this board matches its view's filter.' Loading: 'Loading the\nboard…'.\nRegion names (sidebar, canvas, raise, sunken) are the theme.* roles; widths and margins are layout.* in tokens/. Greys only, on purpose.",
      "originalText": "Reference: briareus-windows. Other clients match this structure, differing only as noted here.\nColumns are 300 to 380px with 12px gaps and share the width when they fit; otherwise the board scrolls sideways with a bar along the bottom. Each column scrolls on its own down to the window's bottom.\nYou can drag a card to another column (needs a Manage token and Projects: write). A card from another repository opens on GitHub; a card from this one opens its issue or PR in the side panel, which really overlays the board rather\nthan taking the 272px right column.\nWith an assignee picked, a 'Showing 5 of 14' line with an accent 'Clear filter' link shows above the columns. A board over 2,000 items warns 'Only the board's first 2,000 items are shown.'\nErrors and empty state: 'Reading a board needs Projects: read on the server's GitHub token (read:project on a classic token)…' / 'Nothing on the board — No item on this board matches its view's filter.' Loading: 'Loading the\nboard…'.\nRegion names (sidebar, canvas, raise, sunken) are the theme.* roles; widths and margins are layout.* in tokens/. Greys only, on purpose.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    }
  ],
