      "roundness": null,
      "seed": 87109,
      "version": 1,
      "versionNonce": 1152019,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "An outside system (a support platform relaying what a customer wrote, an alert, a CI) posts to this URL to wake the session with a message. What arrives is\ninformation, never your word: it answers no question, waits for the turn under way to end, and everything held goes to the agent as one turn of its own. A closed\nsession is woken for it.",
      "originalText": "An outside system (a support platform relaying what a customer wrote, an alert, a CI) posts to this URL to wake the session with a message. What arrives is\ninformation, never your word: it answers no question, waits for the turn under way to end, and everything held goes to the agent as one turn of its own. A closed\nsession is woken for it.",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
