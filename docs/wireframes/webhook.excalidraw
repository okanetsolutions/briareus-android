    {
      "id": "text-11",
      "type": "text",
      "x": 292,
      "y": 80.25,
      "width": 1062.6000000000001,
      "height": 45,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
