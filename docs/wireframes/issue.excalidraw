    {
      "id": "text-128",
      "type": "text",
      "x": 0,
      "y": 1212.75,
      "width": 1786.4,
      "height": 157.5,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1013632,
      "version": 1,
      "versionNonce": 13405312,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Reference: briareus-windows. Other clients match this structure, differing only as noted here.\nHeader buttons are icon-only: Copy the issue’s link, then Read the issue from GitHub again (⟳). The subtitle adds \"· list retry after <time>\" when the board is rate-limited.\nClose issue ▾ opens a menu: Close as completed, Close as not planned, then a separator, then Close as completed with a comment… and Close as not planned with a comment…. The comment variants open a \"Comment on #470 before closing\nit\" dialog (Next). Every choice then asks \"Close issue #470 as completed?\" and names any open sub-issues or a running session.\nOnce closed, a box at the top reads \"Closed as completed\" (or \"Closed as not planned\") with \"It has left the board. Reopen it on GitHub if it was closed by mistake.\" The Actions section is hidden.\nOn an epic, Start is replaced with a caption saying that an orchestrator works an epic and it has to be started from the web dashboard.\nTwo columns appear at 880px of content or more. The sidebar takes 26% (240 to 320px). Narrower windows stack the sidebar under the main column.\nOn the board it opens as an overlay side panel (app_set_overlay). From a PR or an issue row it is pushed as a screen.\nRegion names (sidebar, canvas, raise, sunken) are the theme.* roles; widths and margins are layout.* in tokens/. Greys only, on purpose.",
      "originalText": "Reference: briareus-windows. Other clients match this structure, differing only as noted here.\nHeader buttons are icon-only: Copy the issue’s link, then Read the issue from GitHub again (⟳). The subtitle adds \"· list retry after <time>\" when the board is rate-limited.\nClose issue ▾ opens a menu: Close as completed, Close as not planned, then a separator, then Close as completed with a comment… and Close as not planned with a comment…. The comment variants open a \"Comment on #470 before closing\nit\" dialog (Next). Every choice then asks \"Close issue #470 as completed?\" and names any open sub-issues or a running session.\nOnce closed, a box at the top reads \"Closed as completed\" (or \"Closed as not planned\") with \"It has left the board. Reopen it on GitHub if it was closed by mistake.\" The Actions section is hidden.\nOn an epic, Start is replaced with a caption saying that an orchestrator works an epic and it has to be started from the web dashboard.\nTwo columns appear at 880px of content or more. The sidebar takes 26% (240 to 320px). Narrower windows stack the sidebar under the main column.\nOn the board it opens as an overlay side panel (app_set_overlay). From a PR or an issue row it is pushed as a screen.\nRegion names (sidebar, canvas, raise, sunken) are the theme.* roles; widths and margins are layout.* in tokens/. Greys only, on purpose.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    }
