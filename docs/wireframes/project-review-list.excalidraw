      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Reference: briareus-windows. Other clients match this structure, differing only as noted here.\nThe rows are the same cards as on the Pull requests tab, with the same errands and Merge. There are no filter pickers here.\nWith no GitHub login saved, the header button reads 'Set my GitHub login…' and the status reads '· N waiting on you'. Empty states: 'Nothing is waiting on your review.' / 'Set your GitHub login to see the pull requests waiting on\nyour review.'\nRegion names (sidebar, canvas, raise, sunken) are the theme.* roles; widths and margins are layout.* in tokens/. Greys only, on purpose.",
      "originalText": "Reference: briareus-windows. Other clients match this structure, differing only as noted here.\nThe rows are the same cards as on the Pull requests tab, with the same errands and Merge. There are no filter pickers here.\nWith no GitHub login saved, the header button reads 'Set my GitHub login…' and the status reads '· N waiting on you'. Empty states: 'Nothing is waiting on your review.' / 'Set your GitHub login to see the pull requests waiting on\nyour review.'\nRegion names (sidebar, canvas, raise, sunken) are the theme.* roles; widths and margins are layout.* in tokens/. Greys only, on purpose.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    }
