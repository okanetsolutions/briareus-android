    {
      "id": "text-296",
      "type": "text",
      "x": 0,
      "y": 3020,
      "width": 1786.4,
      "height": 157.5,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2344024,
      "version": 1,
      "versionNonce": 30999784,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Reference: briareus-windows. Other clients match this structure, differing only as noted here.\n'This computer' always comes first in the sidebar and needs no Admin token. The Mail section appears only when the server advertises the mail account route and the token is Admin.\nMeeting assistant has no tabs. 🗑 (remove the ElevenLabs key) appears only when a key is saved. Without VB-Cable, the Virtual microphone section shows a notice and 'Check again'. 'Remove the OpenAI key' appears only if an old key is\nstored.\nMail: each account card's buttons appear only when their routes exist. Connect Gmail / Connect Outlook appear only for providers the server has configured. Sync days and Finish sign-in open text dialogs.\nMCP buttons that toggle (Transport, Enabled, All/Selected repositories, Redirect, secret modes) are bordered buttons whose labels change, not real switches. The repository list uses [x] / [ ] buttons. In stdio mode the fields are\n'Command on the core machine', 'Arguments (JSON array; …)', 'Environment: …' and 'Replacement environment (JSON object)'.\nThere is no settings page in the Windows client for Slack workspaces, Devices & tokens, or Server administration (features.json marks them 'none' for windows), so no frames are drawn for them.\nRegion names (sidebar, canvas, raise, sunken) are the theme.* roles; widths and margins are layout.* in tokens/. Greys only, on purpose.",
      "originalText": "Reference: briareus-windows. Other clients match this structure, differing only as noted here.\n'This computer' always comes first in the sidebar and needs no Admin token. The Mail section appears only when the server advertises the mail account route and the token is Admin.\nMeeting assistant has no tabs. 🗑 (remove the ElevenLabs key) appears only when a key is saved. Without VB-Cable, the Virtual microphone section shows a notice and 'Check again'. 'Remove the OpenAI key' appears only if an old key is\nstored.\nMail: each account card's buttons appear only when their routes exist. Connect Gmail / Connect Outlook appear only for providers the server has configured. Sync days and Finish sign-in open text dialogs.\nMCP buttons that toggle (Transport, Enabled, All/Selected repositories, Redirect, secret modes) are bordered buttons whose labels change, not real switches. The repository list uses [x] / [ ] buttons. In stdio mode the fields are\n'Command on the core machine', 'Arguments (JSON array; …)', 'Environment: …' and 'Replacement environment (JSON object)'.\nThere is no settings page in the Windows client for Slack workspaces, Devices & tokens, or Server administration (features.json marks them 'none' for windows), so no frames are drawn for them.\nRegion names (sidebar, canvas, raise, sunken) are the theme.* roles; widths and margins are layout.* in tokens/. Greys only, on purpose.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    }
  ],
