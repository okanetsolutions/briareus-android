    {
      "id": "text-175",
      "type": "text",
      "x": 0,
      "y": 2000,
      "width": 1778.7,
      "height": 175,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1385825,
      "version": 1,
      "versionNonce": 18327575,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Reference: briareus-windows. Other clients match this structure, differing only as noted here.\nOpened from ⚑ in the sidebar strip (＋ New session, WhatsApp, Mail, 📊, ⚑). ⚑ is shown active and carries the count of held rounds as a badge.\nRounds are grouped by PR (repo · PR #n ↗ opens the PR on GitHub), oldest first. Each round is a raised card. The title opens the conversation, and a finding's title or file:line opens the finding on GitHub.\nFix / Optional / Dismiss is a segmented control: picking the same segment again clears it. Clicking the comment box opens a 'Comment on this finding' dialog, and clicking the note opens a 'Note for the fix session' dialog.\nComplete appears only when every finding is marked. Before that the card shows 'N findings still unmarked; Complete appears once every finding has a verdict.' The label is 'Complete · send N to be fixed', or 'Complete · nothing to\nfix, approve and close' when nothing is marked fix. A confirm dialog comes first ('Start a paid fix session for N findings?' / 'Complete with nothing to fix?' / 'Take this review off the queue?').\nA stale round shows a red line: 'The branch moved after this round was reviewed: some of these may already be fixed…'. A read-only token sees '…This device is read-only: the verdicts are given on the dashboard.' with no controls.\nReply opens a dialog titled 'Reply on this finding’s thread'. Delete asks 'Delete this finding from the review?' with a destructive 'Delete from the review' button.\nPolls every 7 s and F5 refreshes. ⧉ (Open in a new window) moves the page into its own window. SSH/Slack approvals are not on this screen: the Windows client does not implement them.\nRegion names (sidebar, canvas, raise, sunken) are the theme.* roles; widths and margins are layout.* in tokens/. Greys only, on purpose.",
      "originalText": "Reference: briareus-windows. Other clients match this structure, differing only as noted here.\nOpened from ⚑ in the sidebar strip (＋ New session, WhatsApp, Mail, 📊, ⚑). ⚑ is shown active and carries the count of held rounds as a badge.\nRounds are grouped by PR (repo · PR #n ↗ opens the PR on GitHub), oldest first. Each round is a raised card. The title opens the conversation, and a finding's title or file:line opens the finding on GitHub.\nFix / Optional / Dismiss is a segmented control: picking the same segment again clears it. Clicking the comment box opens a 'Comment on this finding' dialog, and clicking the note opens a 'Note for the fix session' dialog.\nComplete appears only when every finding is marked. Before that the card shows 'N findings still unmarked; Complete appears once every finding has a verdict.' The label is 'Complete · send N to be fixed', or 'Complete · nothing to\nfix, approve and close' when nothing is marked fix. A confirm dialog comes first ('Start a paid fix session for N findings?' / 'Complete with nothing to fix?' / 'Take this review off the queue?').\nA stale round shows a red line: 'The branch moved after this round was reviewed: some of these may already be fixed…'. A read-only token sees '…This device is read-only: the verdicts are given on the dashboard.' with no controls.\nReply opens a dialog titled 'Reply on this finding’s thread'. Delete asks 'Delete this finding from the review?' with a destructive 'Delete from the review' button.\nPolls every 7 s and F5 refreshes. ⧉ (Open in a new window) moves the page into its own window. SSH/Slack approvals are not on this screen: the Windows client does not implement them.\nRegion names (sidebar, canvas, raise, sunken) are the theme.* roles; widths and margins are layout.* in tokens/. Greys only, on purpose.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    }
  ],
