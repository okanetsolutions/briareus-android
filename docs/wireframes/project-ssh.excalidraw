    {
      "id": "text-74",
      "type": "text",
      "x": 0,
      "y": 980,
      "width": 1778.7,
      "height": 105,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 586006,
      "version": 1,
      "versionNonce": 7749946,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Reference: briareus-windows. Other clients match this structure, differing only as noted here.\nThe server list is 260px, or a third of the width if that is smaller, with a vertical rule beside it. Each open session is a tab over the built-in terminal, which is a child window and not a separate one.\nReconnect is enabled only when the session is closed. ✕ closes the session and asks 'Disconnect from X?' if it is still live. The header ⟳ reads the project's SSH servers again.\nWith no session open, the right side shows 'No open sessions — Click a server on the left to open an SSH session here…'. Without an Admin token the tab shows 'The SSH servers are read from Settings, which needs an Admin token…'.\nRight-clicking the terminal offers Copy (Ctrl+Shift+C), Paste (Ctrl+Shift+V), Select all and Clear scrollback.\nRegion names (sidebar, canvas, raise, sunken) are the theme.* roles; widths and margins are layout.* in tokens/. Greys only, on purpose.",
      "originalText": "Reference: briareus-windows. Other clients match this structure, differing only as noted here.\nThe server list is 260px, or a third of the width if that is smaller, with a vertical rule beside it. Each open session is a tab over the built-in terminal, which is a child window and not a separate one.\nReconnect is enabled only when the session is closed. ✕ closes the session and asks 'Disconnect from X?' if it is still live. The header ⟳ reads the project's SSH servers again.\nWith no session open, the right side shows 'No open sessions — Click a server on the left to open an SSH session here…'. Without an Admin token the tab shows 'The SSH servers are read from Settings, which needs an Admin token…'.\nRight-clicking the terminal offers Copy (Ctrl+Shift+C), Paste (Ctrl+Shift+V), Select all and Clear scrollback.\nRegion names (sidebar, canvas, raise, sunken) are the theme.* roles; widths and margins are layout.* in tokens/. Greys only, on purpose.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    }
  ],
  "appState": {
    "viewBackgroundColor": "#ffffff",
    "gridSize": null
