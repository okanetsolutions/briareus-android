    },
    {
      "id": "text-124",
      "type": "text",
      "x": 0,
      "y": 980,
      "width": 1794.1000000000001,
      "height": 175,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 981956,
      "version": 1,
      "versionNonce": 12986396,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Reference: briareus-windows. Other clients match this structure, differing only as noted here.\nTab order is fixed: Pull requests, Issues, Board (only if the project names a GitHub Projects board), Review List, Files (if the server reads the repo), Run (Manage token + serve_branch), SSH sessions and SFTP sessions (Admin token),\nDatabase, Forge, then 🎙 Meeting only while a meeting transcript exists.\nOnly the Review List and SSH/SFTP tabs carry counts; the SSH/SFTP count is open sessions.\nHeader buttons are laid right to left in array order, with 🎙 Meet always first (leftmost). Without room for labels they turn into icon buttons.\nEach row is a raised card that opens the PR page when clicked. The errand buttons come from the server catalog and depend on the PR's state; the suggested one (*) is drawn prominent. ↳ Merge is hidden on drafts; 'N runs ›' shows\nonly when conversations ran on the PR. Pressing ▶ Run opens the PR's Run preview.\nWith a filter on, a 'Showing 3 of 12' line with an accent 'Clear filters' link on the right sits above the rows. Empty states: 'No open pull requests.' / 'No pull requests match the filters.' Loading: 'Loading pull requests…'.\nThe filter pickers open a popup menu: 'All authors', then each value with its count, e.g. 'nadin (3)'. The list polls every 45 s, and after a rate limit the header adds '· retry after 14:05'.\nRegion names (sidebar, canvas, raise, sunken) are the theme.* roles; widths and margins are layout.* in tokens/. Greys only, on purpose.",
      "originalText": "Reference: briareus-windows. Other clients match this structure, differing only as noted here.\nTab order is fixed: Pull requests, Issues, Board (only if the project names a GitHub Projects board), Review List, Files (if the server reads the repo), Run (Manage token + serve_branch), SSH sessions and SFTP sessions (Admin token),\nDatabase, Forge, then 🎙 Meeting only while a meeting transcript exists.\nOnly the Review List and SSH/SFTP tabs carry counts; the SSH/SFTP count is open sessions.\nHeader buttons are laid right to left in array order, with 🎙 Meet always first (leftmost). Without room for labels they turn into icon buttons.\nEach row is a raised card that opens the PR page when clicked. The errand buttons come from the server catalog and depend on the PR's state; the suggested one (*) is drawn prominent. ↳ Merge is hidden on drafts; 'N runs ›' shows\nonly when conversations ran on the PR. Pressing ▶ Run opens the PR's Run preview.\nWith a filter on, a 'Showing 3 of 12' line with an accent 'Clear filters' link on the right sits above the rows. Empty states: 'No open pull requests.' / 'No pull requests match the filters.' Loading: 'Loading pull requests…'.\nThe filter pickers open a popup menu: 'All authors', then each value with its count, e.g. 'nadin (3)'. The list polls every 45 s, and after a rate limit the header adds '· retry after 14:05'.\nRegion names (sidebar, canvas, raise, sunken) are the theme.* roles; widths and margins are layout.* in tokens/. Greys only, on purpose.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    }
  ],
  "appState": {
    "viewBackgroundColor": "#ffffff",
    "gridSize": null
  },
  "files": {}
}
