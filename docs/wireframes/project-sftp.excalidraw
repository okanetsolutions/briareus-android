    {
      "id": "text-100",
      "type": "text",
      "x": 0,
      "y": 980,
      "width": 1794.1000000000001,
      "height": 157.5,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 791900,
      "version": 1,
      "versionNonce": 10472900,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Reference: briareus-windows. Other clients match this structure, differing only as noted here.\nThe header buttons are Upload (prominent), Download, a glyph-only new folder button, a glyph-only ⌂ home button, Reconnect (only when the session is closed) and ✕, then ⟳. The new folder and home glyphs are Segoe MDL2 icons, drawn\nhere as 📁 and ⌂.\nThe status line over the tree changes during transfers ('Uploading … · 2 more waiting') and shows a 'Show in folder' link after a download. Right-clicking a row offers Download…/Download folder…, Upload files here…, Upload a\nfolder here…, New folder…, Refresh, Copy path, Rename… and Delete.\nWhile connecting it shows 'Connecting to forge@web-1…' and 'A password or an unknown host key is asked for in a window of its own.' On failure it shows 'Could not connect to …' and 'Connect again'. Password and host-key prompts\ncome up as Win32 MessageBox dialogs ('Trust this server?'), not as Briareus windows.\nThe empty state is 'No open sessions — Click a server on the left to browse its files here…'.\nRegion names (sidebar, canvas, raise, sunken) are the theme.* roles; widths and margins are layout.* in tokens/. Greys only, on purpose.",
      "originalText": "Reference: briareus-windows. Other clients match this structure, differing only as noted here.\nThe header buttons are Upload (prominent), Download, a glyph-only new folder button, a glyph-only ⌂ home button, Reconnect (only when the session is closed) and ✕, then ⟳. The new folder and home glyphs are Segoe MDL2 icons, drawn\nhere as 📁 and ⌂.\nThe status line over the tree changes during transfers ('Uploading … · 2 more waiting') and shows a 'Show in folder' link after a download. Right-clicking a row offers Download…/Download folder…, Upload files here…, Upload a\nfolder here…, New folder…, Refresh, Copy path, Rename… and Delete.\nWhile connecting it shows 'Connecting to forge@web-1…' and 'A password or an unknown host key is asked for in a window of its own.' On failure it shows 'Could not connect to …' and 'Connect again'. Password and host-key prompts\ncome up as Win32 MessageBox dialogs ('Trust this server?'), not as Briareus windows.\nThe empty state is 'No open sessions — Click a server on the left to browse its files here…'.\nRegion names (sidebar, canvas, raise, sunken) are the theme.* roles; widths and margins are layout.* in tokens/. Greys only, on purpose.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    }
  ],
  "appState": {
    "viewBackgroundColor": "#ffffff",
    "gridSize": null
  },
