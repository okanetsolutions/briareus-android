    {
      "id": "text-226",
      "type": "text",
      "x": 0,
      "y": 2000,
      "width": 1678.6000000000001,
      "height": 122.5,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
