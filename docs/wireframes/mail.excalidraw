    {
      "id": "text-153",
      "type": "text",
      "x": 0,
      "y": 980,
      "width": 1794.1000000000001,
      "height": 175,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1211607,
      "version": 1,
      "versionNonce": 16023537,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Reference: briareus-windows. Other clients match this structure, differing only as noted here.\nOpened from the Mail mark in the sidebar strip. It is shown only when the server offers mail and the token is Admin; otherwise the screen reads 'Mail needs an Admin token and the deployed account and message-list routes.' The screen\ncannot be detached.\nThe search box opens a 'Mail filter' dialog. With one mailbox chosen its placeholder is 'Search this mailbox'. The Folder menu offers Any, Inbox, Outside inbox and Exact label…. The Grouping menu offers Group threads and duplicates,\nSeparate messages and Exact thread….\nA row's tag is the account badge: the account label in capitals when it is 4 letters or fewer, otherwise its initials. A thread with several messages shows an 'N in thread' chip, and unread rows have a dot and bold text.\nThe reader shows ✕ Close message and, when the provider gives a safe link, ↗ Open at provider. The delete command reads 'Delete message' (moves to trash after the confirm 'Delete message?' / 'Move to trash') or 'Delete at provider'\nwhen the server has no delete route.\nBelow 680px the reader stacks under the list. With no account the screen says 'No mailbox is connected. Add Gmail or Outlook in Settings, under Mail.' Mail account settings (screen_mail.c) are another agent's Settings screen.\nRegion names (sidebar, canvas, raise, sunken) are the theme.* roles; widths and margins are layout.* in tokens/. Greys only, on purpose.",
      "originalText": "Reference: briareus-windows. Other clients match this structure, differing only as noted here.\nOpened from the Mail mark in the sidebar strip. It is shown only when the server offers mail and the token is Admin; otherwise the screen reads 'Mail needs an Admin token and the deployed account and message-list routes.' The screen\ncannot be detached.\nThe search box opens a 'Mail filter' dialog. With one mailbox chosen its placeholder is 'Search this mailbox'. The Folder menu offers Any, Inbox, Outside inbox and Exact label…. The Grouping menu offers Group threads and duplicates,\nSeparate messages and Exact thread….\nA row's tag is the account badge: the account label in capitals when it is 4 letters or fewer, otherwise its initials. A thread with several messages shows an 'N in thread' chip, and unread rows have a dot and bold text.\nThe reader shows ✕ Close message and, when the provider gives a safe link, ↗ Open at provider. The delete command reads 'Delete message' (moves to trash after the confirm 'Delete message?' / 'Move to trash') or 'Delete at provider'\nwhen the server has no delete route.\nBelow 680px the reader stacks under the list. With no account the screen says 'No mailbox is connected. Add Gmail or Outlook in Settings, under Mail.' Mail account settings (screen_mail.c) are another agent's Settings screen.\nRegion names (sidebar, canvas, raise, sunken) are the theme.* roles; widths and margins are layout.* in tokens/. Greys only, on purpose.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    }
  ],
  "appState": {
    "viewBackgroundColor": "#ffffff",
    "gridSize": null
  },
